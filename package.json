{
  "name": "taktgeber",
  "private": true,
  "version": "2.0.0",
  "description": "Rundown- und Show-Timing-Tool für Live-Produktionen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-core.mjs",
    "build:core": "node scripts/build-core.mjs",
    "server": "node scripts/build-core.mjs && node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "test": "esbuild scripts/test-timing.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-timing.mjs --log-level=warning && node node_modules/.cache/test-timing.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
