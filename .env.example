# Port, auf dem der Server lauscht
PORT=8787
# Interface (0.0.0.0 = alle Netzwerke, 127.0.0.1 = nur lokal, z. B. hinter Reverse-Proxy)
HOST=0.0.0.0
# Speicherort für Daten (state.json) und Sitzungsschlüssel
DATA_DIR=./data
# Hinter Reverse-Proxy (Nginx, Caddy, Synology): true, damit die Login-Drosselung die echte IP sieht
TRUST_PROXY=false
# Optional: eigener Schlüssel für Sitzungen (sonst wird data/secret.key erzeugt)
SESSION_SECRET=
# Optional: zusätzlicher Notfall-Zugang mit Admin-Rechten per Passwort
ADMIN_PASSWORD=
